{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mingli.example/schemas/monthly-facts-v1.schema.json",
  "title": "Mingli Monthly Facts Package v1.1",
  "description": "目标年份流月事实包。版本号跟包一起走：形状变了就升 schema_version，并在 bazi_months.SCHEMA_VERSION 旁写清破坏性变更。",
  "type": "object",
  "required": [
    "schema_version",
    "system",
    "scope",
    "target_year",
    "status",
    "months",
    "half_years",
    "validation"
  ],
  "allOf": [
    {
      "comment": "只有 status=ok 的包才保证有年柱、坐标说明、指纹，且月份恰好 12 个",
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "required": [
          "annual",
          "coordinate",
          "fingerprint",
          "half_years"
        ],
        "properties": {
          "target_year": {
            "type": "integer"
          },
          "months": {
            "minItems": 12,
            "maxItems": 12,
            "prefixItems": [
              {
                "properties": {
                  "index": {
                    "const": 1
                  },
                  "json_pointer": {
                    "const": "/months/0"
                  }
                }
              },
              {
                "properties": {
                  "index": {
                    "const": 2
                  },
                  "json_pointer": {
                    "const": "/months/1"
                  }
                }
              },
              {
                "properties": {
                  "index": {
                    "const": 3
                  },
                  "json_pointer": {
                    "const": "/months/2"
                  }
                }
              },
              {
                "properties": {
                  "index": {
                    "const": 4
                  },
                  "json_pointer": {
                    "const": "/months/3"
                  }
                }
              },
              {
                "properties": {
                  "index": {
                    "const": 5
                  },
                  "json_pointer": {
                    "const": "/months/4"
                  }
                }
              },
              {
                "properties": {
                  "index": {
                    "const": 6
                  },
                  "json_pointer": {
                    "const": "/months/5"
                  }
                }
              },
              {
                "properties": {
                  "index": {
                    "const": 7
                  },
                  "json_pointer": {
                    "const": "/months/6"
                  }
                }
              },
              {
                "properties": {
                  "index": {
                    "const": 8
                  },
                  "json_pointer": {
                    "const": "/months/7"
                  }
                }
              },
              {
                "properties": {
                  "index": {
                    "const": 9
                  },
                  "json_pointer": {
                    "const": "/months/8"
                  }
                }
              },
              {
                "properties": {
                  "index": {
                    "const": 10
                  },
                  "json_pointer": {
                    "const": "/months/9"
                  }
                }
              },
              {
                "properties": {
                  "index": {
                    "const": 11
                  },
                  "json_pointer": {
                    "const": "/months/10"
                  }
                }
              },
              {
                "properties": {
                  "index": {
                    "const": 12
                  },
                  "json_pointer": {
                    "const": "/months/11"
                  }
                }
              }
            ]
          },
          "half_years": {
            "type": "object",
            "required": [
              "first_half",
              "second_half"
            ],
            "properties": {
              "first_half": {
                "type": "object",
                "required": [
                  "months",
                  "start",
                  "end",
                  "first_ganzhi",
                  "last_ganzhi",
                  "evidence_ids"
                ],
                "properties": {
                  "months": {
                    "type": "array",
                    "minItems": 6,
                    "maxItems": 6,
                    "items": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 6
                    },
                    "uniqueItems": true
                  }
                }
              },
              "second_half": {
                "type": "object",
                "required": [
                  "months",
                  "start",
                  "end",
                  "first_ganzhi",
                  "last_ganzhi",
                  "evidence_ids"
                ],
                "properties": {
                  "months": {
                    "type": "array",
                    "minItems": 6,
                    "maxItems": 6,
                    "items": {
                      "type": "integer",
                      "minimum": 7,
                      "maximum": 12
                    },
                    "uniqueItems": true
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "target_year": {
            "type": [
              "integer",
              "null"
            ]
          },
          "months": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "system": {
      "const": "bazi"
    },
    "scope": {
      "const": "monthly"
    },
    "target_year": {
      "type": [
        "integer",
        "null"
      ]
    },
    "status": {
      "enum": [
        "ok",
        "unsupported"
      ]
    },
    "reason": {
      "type": "string"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^mf-[0-9a-f]{8}$"
    },
    "annual": {
      "type": "object",
      "required": [
        "year",
        "gan",
        "zhi",
        "ganzhi"
      ],
      "properties": {
        "year": {
          "type": "integer"
        },
        "gan": {
          "type": "string",
          "minLength": 1
        },
        "zhi": {
          "type": "string",
          "minLength": 1
        },
        "ganzhi": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        }
      }
    },
    "birth_pillars": {
      "type": [
        "object",
        "null"
      ]
    },
    "coordinate": {
      "type": "object",
      "required": [
        "year_boundary",
        "month_boundary",
        "timezone",
        "interval",
        "engine"
      ],
      "properties": {
        "year_boundary": {
          "type": "string"
        },
        "month_boundary": {
          "type": "string"
        },
        "timezone": {
          "const": "UTC+08:00"
        },
        "interval": {
          "type": "string"
        },
        "engine": {
          "type": "string"
        }
      }
    },
    "months": {
      "type": "array",
      "minItems": 0,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/month"
      }
    },
    "half_years": {
      "type": "object",
      "properties": {
        "first_half": {
          "$ref": "#/$defs/halfYear"
        },
        "second_half": {
          "$ref": "#/$defs/halfYear"
        }
      }
    },
    "layers": {
      "type": "object",
      "properties": {
        "luck": {
          "$ref": "#/$defs/luckLayer"
        }
      }
    },
    "relation_audit": {
      "$ref": "#/$defs/relationAudit"
    },
    "validation": {
      "type": "object",
      "required": [
        "status",
        "checks"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "pass",
              "detail"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "pass": {
                "type": "boolean"
              },
              "detail": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "instant": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?\\+08:00$",
      "format": "date-time"
    },
    "month": {
      "type": "object",
      "required": [
        "index",
        "label",
        "gan",
        "zhi",
        "ganzhi",
        "jie",
        "start",
        "end",
        "start_utc_offset",
        "duration_days",
        "boundary_source",
        "evidence_id",
        "json_pointer",
        "status"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "gan": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        },
        "zhi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        },
        "ganzhi": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        },
        "jie": {
          "type": "string",
          "minLength": 1
        },
        "jie_longitude": {
          "type": "number"
        },
        "next_jie": {
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/instant"
        },
        "end": {
          "$ref": "#/$defs/instant"
        },
        "start_utc_offset": {
          "const": "+08:00"
        },
        "duration_days": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "boundary_source": {
          "const": "solar_term_apparent_longitude"
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "json_pointer": {
          "type": "string",
          "pattern": "^/months/(0|1[01]|[0-9])(/relation_segments/(0|1|2)/relations/[0-9]+|/relations/[0-9]+)?$"
        },
        "status": {
          "type": "string"
        },
        "relation_count": {
          "type": "integer",
          "minimum": 0
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation"
          }
        },
        "relation_segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/segment"
          }
        },
        "luck": {
          "$ref": "#/$defs/monthLuck"
        },
        "relation_scope": {
          "$ref": "#/$defs/relationScope"
        }
      }
    },
    "monthLuck": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "before_start",
            "indeterminate",
            "split",
            "unavailable"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "ganzhi": {
          "type": [
            "string",
            "null"
          ]
        },
        "gan": {
          "type": [
            "string",
            "null"
          ]
        },
        "zhi": {
          "type": [
            "string",
            "null"
          ]
        },
        "sequence": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "age_range": {
          "type": [
            "string",
            "null"
          ]
        },
        "from": {
          "type": [
            "string",
            "null"
          ]
        },
        "to": {
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "type": [
            "string",
            "null"
          ]
        },
        "boundaries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ambiguous": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "time_precision": {
          "type": "string"
        },
        "birth_time_tolerance_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "boundary_precision": {
          "enum": [
            "exact",
            "birth-time-approximate"
          ]
        },
        "boundary_uncertainty_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "ambiguous_windows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "segments": {
          "type": "array"
        }
      }
    },
    "relationScope": {
      "type": "object",
      "required": [
        "computed_layers",
        "omitted_layers",
        "reason",
        "boundaries",
        "segments"
      ],
      "properties": {
        "computed_layers": {
          "type": "array",
          "items": {
            "enum": [
              "natal",
              "luck",
              "annual",
              "monthly"
            ]
          }
        },
        "omitted_layers": {
          "type": "array",
          "items": {
            "enum": [
              "natal",
              "luck",
              "annual",
              "monthly"
            ]
          }
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "boundaries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "segments": {
          "type": "integer",
          "minimum": 0
        },
        "suggestion": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "segment": {
      "type": "object",
      "required": [
        "segment",
        "start",
        "end",
        "luck"
      ],
      "properties": {
        "segment": {
          "type": "integer",
          "minimum": 1
        },
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        },
        "uncertain_band": {
          "type": "boolean"
        },
        "luck": {
          "type": "object"
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation"
          }
        },
        "relation_scope": {
          "$ref": "#/$defs/relationScope"
        }
      }
    },
    "relation": {
      "type": "object",
      "required": [
        "evidence_id",
        "kind",
        "participants",
        "layers",
        "bindings"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "original_evidence_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "participants": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "participant",
              "layer",
              "channel",
              "value"
            ],
            "properties": {
              "participant": {
                "type": "string"
              },
              "layer": {
                "enum": [
                  "natal",
                  "luck",
                  "annual",
                  "monthly",
                  "unknown"
                ]
              },
              "channel": {
                "enum": [
                  "stem",
                  "branch"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "required_values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "transformation": {
          "type": "object"
        },
        "segment": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "halfYear": {
      "type": "object",
      "required": [
        "months",
        "start",
        "end",
        "first_ganzhi",
        "last_ganzhi",
        "evidence_ids"
      ],
      "properties": {
        "months": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        },
        "first_ganzhi": {
          "type": "string"
        },
        "last_ganzhi": {
          "type": "string"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "luckLayer": {
      "type": "object",
      "required": [
        "status",
        "mid_year",
        "months_with_luck",
        "months_without_luck",
        "resolved_per_month"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "unavailable"
          ]
        },
        "mid_year": {
          "type": "object",
          "required": [
            "scope",
            "status"
          ],
          "properties": {
            "scope": {
              "const": "mid-year"
            },
            "status": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "ganzhi": {
              "type": [
                "string",
                "null"
              ]
            },
            "at": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "resolved_per_month": {
          "type": "boolean"
        },
        "cycles_used": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "crossed_months": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "months_with_luck": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "months_without_luck": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "relationAudit": {
      "type": "object",
      "required": [
        "status",
        "layers",
        "luck_coverage",
        "supported",
        "unsupported"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "partial"
          ]
        },
        "layers": {
          "type": "array",
          "items": {
            "enum": [
              "natal",
              "luck",
              "annual",
              "monthly"
            ]
          }
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "luck_coverage": {
          "type": "object",
          "required": [
            "coverage",
            "months_with_luck",
            "months_without_luck"
          ],
          "properties": {
            "coverage": {
              "enum": [
                "full",
                "partial"
              ]
            },
            "months_with_luck": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "months_without_luck": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          }
        },
        "supported": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unsupported": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unsupported_note": {
          "type": "string"
        }
      }
    }
  }
}
